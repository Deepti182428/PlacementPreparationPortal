<!doctype html><html><head><%- include('partials/head',{title:'Login'}) %></head><body><%- include('partials/nav') %><main class="container py-5"><div class="row justify-content-center"><div class="col-md-6"><div class="card p-4 p-md-5"><h2>Welcome back</h2><p class="text-secondary">Sign in to continue your preparation.</p><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %><% if(message){ %><div class="alert alert-success"><%= message %></div><% } %><form method="post" action="/login"><label>Email</label><input type="email" class="form-control mb-3" name="email" required><label>Password</label><input type="password" class="form-control mb-4" name="password" required><button class="btn btn-primary w-100">Sign in</button></form><p class="mt-4 mb-0">New here? <a href="/register">Create an account</a></p></div></div></div></main><%- include('partials/footer') %></body></html>
