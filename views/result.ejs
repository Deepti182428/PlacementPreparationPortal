<!doctype html><html><head><%- include('partials/head',{title:'Test Result'}) %></head><body><%- include('partials/nav') %><main class="container py-5"><div class="text-center"><p class="text-primary fw-bold">TEST COMPLETE</p><h1>Your result</h1><div class="card p-5 mx-auto mt-4" style="max-width:700px"><div class="stat text-primary"><%= percentage %>%</div><p class="text-secondary">Final score: <strong><%= score %>/<%= total %></strong></p><div class="row g-3 text-start mt-3"><div class="col-6"><div class="bg-light p-3 rounded">Attempted <strong class="float-end"><%= attempted %></strong></div></div><div class="col-6"><div class="bg-light p-3 rounded">Correct <strong class="float-end text-success"><%= correct %></strong></div></div><div class="col-6"><div class="bg-light p-3 rounded">Wrong <strong class="float-end text-danger"><%= wrong %></strong></div></div><div class="col-6"><div class="bg-light p-3 rounded">Total <strong class="float-end"><%= total %></strong></div></div></div><div class="mt-4"><a href="/test" class="btn btn-primary">Try again</a> <a href="/performance" class="btn btn-outline-primary">See performance</a></div></div></div></main><%- include('partials/footer') %></body></html>
