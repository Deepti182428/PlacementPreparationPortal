<!doctype html><html><head><%- include('partials/head',{title:'Aptitude Test'}) %></head><body><%- include('partials/nav') %><main class="container py-5"><div class="d-flex justify-content-between"><div><p class="text-primary fw-bold mb-1">APTITUDE TEST</p><h1>Sharpen your thinking</h1></div><span class="badge bg-light text-dark align-self-start p-3"><%= questions.length %> questions</span></div><form method="post" action="/test/submit" data-confirm-submit><% questions.forEach((q,i)=>{ %><div class="card p-4 my-4"><p class="text-secondary">Question <%= i+1 %></p><h5><%= q.question %></h5><% [['A',q.option_a],['B',q.option_b],['C',q.option_c],['D',q.option_d]].forEach(o=>{ %><label class="option"><input type="radio" name="answers[<%= q.id %>]" value="<%= o[0] %>" class="me-2"><%= o[0] %>. <%= o[1] %></label><% }) %></div><% }) %><button class="btn btn-primary btn-lg mb-5">Submit test</button></form></main><%- include('partials/footer') %></body></html>
