<!doctype html><html><head><%- include('partials/head',{title:'Register'}) %></head><body><%- include('partials/nav') %><main class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="card p-4 p-md-5"><h2>Create student account</h2><p class="text-secondary">Start tracking your aptitude practice.</p><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %><form method="post" action="/register" class="row g-3"><div class="col-md-6"><label>Full name</label><input class="form-control" name="fullName" required></div><div class="col-md-6"><label>Roll number</label><input class="form-control" name="rollNumber" required></div><div class="col-md-6"><label>Department</label><input class="form-control" name="department" required></div><div class="col-md-6"><label>Mobile number</label><input class="form-control" name="mobile" required></div><div class="col-12"><label>Email</label><input type="email" class="form-control" name="email" required></div><div class="col-md-6"><label>Password</label><input type="password" class="form-control" name="password" minlength="8" required></div><div class="col-md-6"><label>Confirm password</label><input type="password" class="form-control" name="confirmPassword" minlength="8" required></div><div class="col-12"><button class="btn btn-primary w-100">Create account</button></div></form><p class="mt-4 mb-0">Already registered? <a href="/login">Sign in</a></p></div></div></div></main><%- include('partials/footer') %></body></html>
