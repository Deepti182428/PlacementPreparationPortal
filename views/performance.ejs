<!doctype html><html><head><%- include('partials/head',{title:'Performance'}) %></head><body><%- include('partials/nav') %><main class="container py-5"><p class="text-primary fw-bold mb-1">INSIGHTS</p><h1>Performance analysis</h1><div class="row g-4 my-3"><% [['Highest score',highest],['Lowest score',lowest],['Average score',average],['Tests attempted',history.length]].forEach(s=>{ %><div class="col-6 col-lg-3"><div class="card p-4"><small class="text-secondary"><%= s[0] %></small><div class="stat"><%= s[1] %></div></div></div><% }) %></div><div class="card p-4"><h4>Progress graph</h4><canvas id="progress" height="100"></canvas></div><div class="card p-4 mt-4"><h4>Test history</h4><div class="table-responsive"><table class="table"><tr><th>Date</th><th>Correct</th><th>Wrong</th><th>Percentage</th></tr><% history.forEach(x=>{ %><tr><td><%= new Date(x.completed_at).toLocaleDateString() %></td><td><%= x.correct_answers %></td><td><%= x.wrong_answers %></td><td><%= x.percentage %>%</td></tr><% }) %></table></div></div></main><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><script>new Chart(document.getElementById('progress'),{type:'line',data:{labels:<%- JSON.stringify(history.map((x,i)=>'Test '+(history.length-i))) %>,datasets:[{label:'Percentage',data:<%- JSON.stringify(history.map(x=>x.percentage).reverse()) %>,borderColor:'#2864dc',backgroundColor:'#2864dc22',fill:true,tension:.35}]},options:{scales:{y:{beginAtZero:true,max:100}}}});</script><%- include('partials/footer') %></body></html>
